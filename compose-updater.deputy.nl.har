            "compression": 7489,
            "text": ":root {\n  color-scheme: light dark;\n  --bg: #ffffff;\n  --fg: #1a1a1a;\n  --muted: #666;\n  --border: #ddd;\n  --accent: #2563eb;\n  --ok: #16a34a;\n  --fail: #dc2626;\n  --warn: #d97706;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #14161a;\n    --fg: #e6e6e6;\n    --muted: #9a9a9a;\n    --border: #333;\n    --accent: #5b9dff;\n    --ok: #4ade80;\n    --fail: #f87171;\n    --warn: #fbbf24;\n  }\n}\n\n* { box-sizing: border-box; }\n\n/* App shell: header/toolbar have a fixed natural height and are always\n   visible; .layout takes the rest of the viewport and never itself\n   scrolls - only the two panels inside it do, independently. */\nhtml, body { height: 100%; }\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  background: var(--bg);\n  color: var(--fg);\n  margin: 0;\n  padding: 1rem 1.5rem;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\nheader {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: .75rem;\n  flex: 0 0 auto;\n}\nh1 { font-size: 1.1rem; margin: 0; }\nh2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 0 0 .5rem; flex: 0 0 auto; }\n\n/* Mirrors .layout's grid so each half of the toolbar sits directly above\n   the panel it controls - the filter box ends up the same width as, and\n   flush above, the console panel it filters. */\n.toolbar {\n  display: grid;\n  grid-template-columns: minmax(500px, 600px) 1fr;\n  align-items: center;\n  gap: 1rem;\n  margin-bottom: .75rem;\n  flex: 0 0 auto;\n}\n.toolbar-actions {\n  display: flex;\n  align-items: center;\n  gap: .5rem;\n  min-width: 0;\n}\n\n.layout {\n  display: grid;\n  grid-template-columns: minmax(500px, 600px) 1fr;\n  gap: 1rem;\n  flex: 1 1 auto;\n  min-height: 0; /* let a grid row shrink to the remaining space instead of growing to content */\n}\n@media (max-width: 860px) {\n  body { overflow: visible; height: auto; }\n  .toolbar { grid-template-columns: 1fr; gap: .5rem; }\n  .layout { grid-template-columns: 1fr; flex: 0 0 auto; }\n}\n\n.panel {\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: .5rem .65rem;\n  min-width: 0; /* let a grid/flex child shrink below its content's natural width */\n  height: 100%;\n  min-height: 0;\n}\n.stacks-panel {\n  overflow: auto; /* only the list scrolls; header/toolbar/table head stay put */\n  --strip-h: 0px; /* live height of .updating-strip, set by app.js so the sticky\n                     table header can sit right below it instead of overlapping */\n}\n@media (max-width: 860px) {\n  .panel { height: auto; }\n  .stacks-panel { overflow: visible; }\n}\n\nbutton {\n  font: inherit;\n  font-size: .85rem;\n  padding: .3rem .65rem;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  background: transparent;\n  color: var(--fg);\n  cursor: pointer;\n  white-space: nowrap;\n}\nbutton.primary {\n  background: var(--accent);\n  border-color: var(--accent);\n  color: #fff;\n}\nbutton.link-btn {\n  border: none;\n  background: none;\n  color: var(--muted);\n  text-decoration: underline;\n  padding: 0;\n}\n\nbutton.update-btn { padding: .2rem .5rem; font-size: .72rem; }\n\n/* Post-update-steps indicator button: muted/outline when unconfigured,\n   accent-colored once a script is set, so it doubles as an indicator. */\nbutton.post-btn {\n  padding: .2rem .4rem;\n  font-size: .68rem;\n  font-family: ui-monospace, \"SF Mono\", Menlo, monospace;\n  color: var(--muted);\n}\nbutton.post-btn.has-script {\n  color: var(--accent);\n  border-color: var(--accent);\n}\n/* Toolbar variant (final-step button): same on/off color coding as\n   post-btn, but normal button size/font to match its toolbar siblings. */\n#final-step-btn {\n  font-family: inherit;\n  font-size: .85rem;\n  padding: .3rem .65rem;\n}\n\n/* Toggle switch (include-in-group-update control) */\nbutton.switch {\n  position: relative;\n  width: 2rem;\n  height: 1.1rem;\n  padding: 0;\n  border: none;\n  border-radius: 999px;\n  background: var(--border);\n  cursor: pointer;\n  flex-shrink: 0;\n  vertical-align: middle;\n}\nbutton.switch .thumb {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: .9rem;\n  height: .9rem;\n  border-radius: 50%;\n  background: #fff;\n  transition: left .15s ease;\n}\nbutton.switch.on { background: var(--ok); }\nbutton.switch.on .thumb { left: calc(100% - .9rem - 2px); }\n\n/* Summary of currently-updating stacks, shown at the top of the panel in\n   addition to (not instead of) each stack's normal alphabetical row below -\n   the table itself never reorders, so rows don't jump around mid-update.\n   Sticky (like the table head below it) so it stays visible no matter how\n   far down the list is scrolled; app.js keeps --strip-h in sync with its\n   real height so the table head can offset below it instead of overlapping. */\n.updating-strip {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  display: flex;\n  flex-wrap: wrap;\n  gap: .4rem;\n  background: var(--bg);\n  /* Same compositing-layer fix as table.stacks th below - without it these\n     two stacked sticky elements can let scrolled-past row content show\n     through during the scroll gesture in some browsers. */\n  will-change: transform;\n  transform: translateZ(0);\n}\n.updating-strip:not(:empty) {\n  padding-bottom: .5rem;\n  margin-bottom: .5rem;\n  border-bottom: 1px solid var(--border);\n}\n.updating-chip {\n  min-width: 9rem;\n  padding: .3rem .5rem;\n  border: 1px solid var(--accent);\n  border-radius: 6px;\n  font-size: .7rem;\n}\n.updating-chip .chip-name {\n  display: block;\n  font-weight: 600;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  margin-bottom: .25rem;\n}\n.updating-chip .progress-label { margin-top: .1rem; }\n\ntable.stacks {\n  width: 100%;\n  table-layout: fixed; /* fixed column widths below so content can never push the table past the panel */\n  /* separate (not collapse): position:sticky on thead th is unreliable\n     with border-collapse in some browsers (notably Safari) */\n  border-collapse: separate;\n  border-spacing: 0;\n  font-size: .78rem;\n}\ntable.stacks th, table.stacks td {\n  text-align: left;\n  padding: .3rem .35rem;\n  border-bottom: 1px solid var(--border);\n  line-height: 1.3;\n  overflow: hidden;\n}\ntable.stacks th {\n  position: sticky;\n  top: var(--strip-h, 0px); /* sits right below .updating-strip instead of under it */\n  z-index: 1;\n  background: var(--bg);\n  /* Forces its own compositing layer - without this, some browsers\n     (notably Chrome) can fail to paint a sticky element as fully opaque\n     while scrolling, letting the content behind it show through. */\n  will-change: transform;\n  transform: translateZ(0);\n  font-size: .68rem;\n  text-transform: uppercase;\n  letter-spacing: .03em;\n  color: var(--muted);\n  font-weight: 600;\n  white-space: nowrap;\n  text-overflow: ellipsis; /* safety net if a label is ever too tight for its column */\n}\ntable.stacks th:nth-child(1), table.stacks td:nth-child(1) { width: 2.75rem; }\ntable.stacks th:nth-child(2), table.stacks td:nth-child(2) { width: 2.4rem; }\ntable.stacks th:nth-child(4), table.stacks td:nth-child(4) { width: 4.5rem; }\ntable.stacks th:nth-child(5), table.stacks td:nth-child(5) { width: 8.5rem; }\ntable.stacks th:nth-child(6), table.stacks td:nth-child(6) { width: 4.5rem; }\ntable.stacks .name {\n  font-weight: 600;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n\n.pill {\n  display: inline-block;\n  padding: 0 .4rem;\n  border-radius: 999px;\n  font-size: .68rem;\n  line-height: 1.5;\n  border: 1px solid var(--border);\n  text-transform: capitalize;\n}\n.pill-updating { color: var(--accent); border-color: var(--accent); }\n.pill-success { color: var(--ok); border-color: var(--ok); }\n.pill-failed { color: var(--fail); border-color: var(--fail); }\n\n.err { cursor: help; }\n\n.run-indicator { color: var(--accent); font-size: .8rem; }\n\n.bar {\n  width: 100%;\n  height: 5px;\n  border-radius: 3px;\n  background: var(--border);\n  overflow: hidden;\n}\n.bar-fill {\n  height: 100%;\n  background: var(--accent);\n  transition: width .2s ease;\n}\n.progress-label {\n  font-size: .65rem;\n  color: var(--muted);\n  margin-top: .15rem;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.console-panel {\n  display: flex;\n  flex-direction: column;\n}\n/* Lines up with the panel's own inner content edge (border + padding)\n   below it, so its left/right edges match the console pane exactly\n   instead of the wider toolbar grid cell it sits in. Width is computed\n   explicitly (not width:auto) because <input> keeps its own intrinsic\n   ~20-character width inside a grid/flex track regardless of stretch\n   alignment - unlike a <div>, it won't fill the track on its own. */\n.console-filter {\n  display: block;\n  width: calc(100% - 1.3rem - 2px);\n  margin-left: calc(.65rem + 1px);\n  box-sizing: border-box;\n  /* Reset native control chrome first - some browsers/OS themes render\n     text inputs with their own square, grey-filled widget and ignore\n     border-radius/background entirely until appearance is cleared. */\n  appearance: none;\n  -webkit-appearance: none;\n  -moz-appearance: none;\n  font-family: ui-monospace, \"SF Mono\", Menlo, monospace;\n  font-size: .78rem;\n  padding: .35rem .7rem;\n  border-radius: 8px;\n  border: 1px solid var(--border);\n  background: var(--bg);\n  color: var(--fg);\n}\n.console-filter::placeholder { color: var(--muted); }\n.console-filter:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n@media (max-width: 860px) {\n  .console-panel { height: 60vh; }\n}\n.console {\n  flex: 1;\n  min-height: 0;\n  background: #0b0d10;\n  color: #d6f5d6;\n  border-radius: 6px;\n  padding: .6rem .75rem;\n  overflow-y: auto;\n  font-family: ui-monospace, \"SF Mono\", Menlo, monospace;\n  font-size: .78rem;\n  white-space: pre-wrap;\n}\n\n.auth-page {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n}\n.auth-form {\n  display: flex;\n  flex-direction: column;\n  gap: .75rem;\n  width: 100%;\n  max-width: 320px;\n}\n.auth-form label { display: flex; flex-direction: column; gap: .25rem; font-size: .9rem; }\n.auth-form input {\n  font: inherit;\n  padding: .5rem;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  background: var(--bg);\n  color: var(--fg);\n}\n.hint { color: var(--muted); font-size: .85rem; }\n.error { color: var(--fail); font-size: .9rem; }\n\n.post-dialog {\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 1rem 1.25rem;\n  width: 100%;\n  max-width: 480px;\n  background: var(--bg);\n  color: var(--fg);\n}\n.post-dialog::backdrop { background: rgba(0, 0, 0, .4); }\n.post-dialog h2 { margin: 0 0 .5rem; text-transform: none; letter-spacing: normal; font-size: 1rem; color: var(--fg); }\n.post-dialog textarea, .post-dialog input[type=\"text\"] {\n  width: 100%;\n  font-family: ui-monospace, \"SF Mono\", Menlo, monospace;\n  font-size: .8rem;\n  padding: .5rem;\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  background: var(--bg);\n  color: var(--fg);\n  box-sizing: border-box;\n}\n.post-dialog textarea { resize: vertical; }\n.field-label {\n  display: block;\n  font-size: .8rem;\n  color: var(--muted);\n  margin: .5rem 0 .25rem;\n}\n.post-edit-actions {\n  display: flex;\n  gap: .5rem;\n  margin-top: .75rem;\n}\n.checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: .4rem;\n  font-size: .85rem;\n  margin-bottom: .5rem;\n}\n.checkbox-label input { margin: 0; }\n"
          },
