            "text": "\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>updatecontainers</title>\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/static/favicon.svg\">\n  <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/static/favicon.png\">\n  <link rel=\"stylesheet\" href=\"/static/style.css\">\n  <script src=\"/static/htmx.min.js\"></script>\n</head>\n<body>\n  <header>\n    <h1>update containers</h1>\n    <form method=\"post\" action=\"/logout\" class=\"logout\"><button type=\"submit\" class=\"link-btn\">Log out</button></form>\n  </header>\n\n  <div class=\"toolbar\">\n    <div class=\"toolbar-actions\">\n      <button type=\"button\" id=\"update-selected\" name=\"target\" value=\"all\"\n        class=\"primary\" hx-post=\"/api/update\" hx-swap=\"none\">Update selected</button>\n      <button type=\"button\" id=\"rescan\" hx-post=\"/api/rescan\" hx-target=\"#stack-table-body\" hx-swap=\"innerHTML\">Rescan folder</button>\n      \n<button type=\"button\" id=\"final-step-btn\" class=\"post-btn has-script\"\n  data-enabled=\"1\" data-script=\"docker image prune -a -f\"\n  title=\"Final step (runs after Update selected):&#10;docker image prune -a -f\">Final step</button>\n\n      <span id=\"run-indicator\" class=\"run-indicator\" hidden>updating…</span>\n    </div>\n    <input type=\"text\" id=\"console-filter\" class=\"console-filter\" placeholder=\"Filter live output…\" aria-label=\"Filter live output by container name or log text\">\n  </div>\n\n  <div class=\"layout\">\n    <section class=\"panel stacks-panel\">\n      <div id=\"updating-strip\" class=\"updating-strip\"></div>\n      <table class=\"stacks\">\n        <thead>\n          <tr>\n            <th title=\"Include in group update\">On</th>\n            <th title=\"Post-update steps\">Post</th>\n            <th>Name</th>\n            <th>Status</th>\n            <th>Updated</th>\